{
  "name": "zustand-tools",
  "version": "0.1.0",
  "description": "Create zustand stores in one line: auto-generated state setters and hooks, custom actions, middleware support, and React context stores.",
  "keywords": [
    "zustand",
    "toolkit",
    "tools",
    "helper",
    "simple",
    "react",
    "state management"
  ],
  "author": "WuifDesign",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuifdesign/zustand-tools.git"
  },
  "homepage": "https://github.com/wuifdesign/zustand-tools#readme",
  "bugs": {
    "url": "https://github.com/wuifdesign/zustand-tools/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src/lib",
    "!src/lib/**/*.spec.ts",
    "!src/lib/**/*.spec.tsx",
    "!src/lib/**/*.bench.tsx"
  ],
  "scripts": {
    "sbx": "sbx run --name zustand-tools",
    "build": "tsdown",
    "dev": "vite examples/demo",
    "test": "npm run test:unit && npm run test:typecheck",
    "test:unit": "vitest run",
    "test:typecheck": "tsc --noEmit",
    "bench": "vitest bench --run --reporter=verbose",
    "lint": "npm run lint:oxlint && npm run lint:prettier",
    "lint:oxlint": "oxlint src examples --deny-warnings",
    "lint:oxlint:fix": "oxlint src examples --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:package": "publint && attw --pack . --profile node16",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "node": "24.22.1"
  },
  "tsdown": {
    "entry": [
      "src/lib/index.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true,
    "sourcemap": true,
    "clean": true,
    "platform": "neutral",
    "tsconfig": "tsconfig.build.json"
  }
}
