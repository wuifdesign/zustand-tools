{
  "name": "zustand-tools",
  "version": "0.1.0",
  "description": "Create zustand stores in one line: auto-generated state setters and hooks, custom actions, middleware support, and React context stores.",
  "keywords": [
    "zustand",
    "toolkit",
    "tools",
    "helper",
    "simple",
    "react",
    "state management"
  ],
  "author": "wuifdesign",
  "license": "MIT",
  "repository": "https://github.com/wuifdesign/zustand-tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "dist/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "sbx": "sbx run --name zustand-tools",
    "build": "npm run clear-dist && tsc --project tsconfig.build.json",
    "clear-dist": "rimraf dist",
    "dev": "vite",
    "test": "npm run test:unit && npm run test:typecheck",
    "test:unit": "vitest run",
    "test:typecheck": "tsc --noEmit",
    "lint": "npm run lint:oxlint && npm run lint:prettier",
    "lint:oxlint": "oxlint src",
    "lint:oxlint:fix": "oxlint src --fix",
    "lint:prettier": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint:prettier:fix": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "volta": {
    "node": "24.22.1"
  }
}
